<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.8</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.tgaws</groupId>
    <artifactId>tgaws-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>tgaws-parent</name>
    <description>隧道地质灾害AI预警系统（TGAWS）父工程：1 父 POM + 5 子模块（《2.系统架构设计说明书》2.3.1）</description>

    <modules>
        <module>tgaws-common</module>
        <module>tgaws-access</module>
        <module>tgaws-compute</module>
        <module>tgaws-business</module>
        <module>tgaws-web</module>
        <!-- 工具模块：网关模拟器（T2 压测/T-902b 离线联调/T-902a 协议确认复用；不入交付安装包） -->
        <module>tools/gateway-simulator</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <!-- MyBatis 4.0.x 为官方 Spring Boot 4 适配线（T1 已验证通过） -->
        <mybatis-spring-boot.version>4.0.1</mybatis-spring-boot.version>
        <!-- T-705 覆盖率门禁：分支覆盖率固底阈值（各模块按实测 -3 点设置，向 7.5 目标 70%/90% 逐周爬坡，
             见《8》8.2 覆盖率爬坡表；模块 pom 可覆盖本值） -->
        <jacoco.branch.min>0.30</jacoco.branch.min>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.mybatis.spring.boot</groupId>
                <artifactId>mybatis-spring-boot-starter</artifactId>
                <version>${mybatis-spring-boot.version}</version>
            </dependency>
            <!-- W4 接入层：内嵌 MQTT Broker（0.17.x；子模块引用时须排除其传递的 Netty，
                 统一走 Boot BOM 管理的 Netty，杜绝双 Netty 版本共存） -->
            <dependency>
                <groupId>io.moquette</groupId>
                <artifactId>moquette-broker</artifactId>
                <version>0.17</version>
            </dependency>
            <!-- W4 数据管道：应用内有界队列（Boot BOM 未管理，显式锁版） -->
            <dependency>
                <groupId>com.lmax</groupId>
                <artifactId>disruptor</artifactId>
                <version>3.4.4</version>
            </dependency>
            <!-- MySQL 驱动：显式锁定 9.7.0（Boot 4.0.8 实际解析版本；需连真实库的模块声明 runtime 依赖） -->
            <dependency>
                <groupId>com.mysql</groupId>
                <artifactId>mysql-connector-j</artifactId>
                <version>9.7.0</version>
            </dependency>
            <!-- W5 计算层：规则表达式引擎（提前锁版，避免 W5 再动父 POM） -->
            <dependency>
                <groupId>com.googlecode.aviator</groupId>
                <artifactId>aviator</artifactId>
                <version>5.4.3</version>
            </dependency>
            <!-- W5 计算层：统计模型 -->
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-math3</artifactId>
                <version>3.6.1</version>
            </dependency>
            <!-- W4-3 T3 验证：MQTT 测试客户端（test scope 引用） -->
            <dependency>
                <groupId>org.eclipse.paho</groupId>
                <artifactId>org.eclipse.paho.client.mqttv3</artifactId>
                <version>1.2.5</version>
            </dependency>
            <!-- W6 认证：JWT（jjwt 0.12.x，Boot BOM 未管理） -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>0.12.6</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>0.12.6</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>0.12.6</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.6</version>
                    <configuration>
                        <!-- C 盘纪律：测试临时目录（moquette UUID/JUnit/surefire booter）一律落在模块 target 下（D 盘） -->
                        <tempDirectory>${project.build.directory}/surefire-tmp</tempDirectory>
                        <systemPropertyVariables>
                            <java.io.tmpdir>${project.build.directory}/tmp</java.io.tmpdir>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- T-705 JaCoCo 覆盖率门禁（7.5 目标落地机制）：分支覆盖 ≥70%，不达标 verify 失败 -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.14</version>
                <configuration>
                    <!-- 中文项目路径经 cmd.exe（GBK）fork 会被编码破坏，exec 必须落 ASCII 路径 -->
                    <destFile>D:/tgaws-jacoco/${project.artifactId}.exec</destFile>
                    <dataFile>D:/tgaws-jacoco/${project.artifactId}.exec</dataFile>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>coverage-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.branch.min}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- T-704 P3C 静态扫描：verify 阶段 P1 阻断级失败即构建失败 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <version>3.21.2</version>
                <configuration>
                    <printFailingErrors>true</printFailingErrors>
                    <failurePriority>1</failurePriority>
                    <rulesets>
                        <ruleset>rulesets/java/ali-comment.xml</ruleset>
                        <ruleset>rulesets/java/ali-concurrent.xml</ruleset>
                        <ruleset>rulesets/java/ali-constant.xml</ruleset>
                        <ruleset>rulesets/java/ali-exception.xml</ruleset>
                        <ruleset>rulesets/java/ali-flowcontrol.xml</ruleset>
                        <ruleset>rulesets/java/ali-naming.xml</ruleset>
                        <ruleset>rulesets/java/ali-oop.xml</ruleset>
                        <ruleset>rulesets/java/ali-orm.xml</ruleset>
                        <ruleset>rulesets/java/ali-other.xml</ruleset>
                        <ruleset>rulesets/java/ali-set.xml</ruleset>
                    </rulesets>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>com.alibaba.p3c</groupId>
                        <artifactId>p3c-pmd</artifactId>
                        <version>2.1.1</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <id>p3c-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
