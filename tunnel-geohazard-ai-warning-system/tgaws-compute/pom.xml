<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.tgaws</groupId>
        <artifactId>tgaws-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>tgaws-compute</artifactId>
    <name>tgaws-compute</name>
    <description>计算层：规则引擎/突变检测/预测/综合研判/管道（W5 填充，Disruptor/Aviator/Commons Math 依赖届时加入）</description>
    <properties>
        <jacoco.branch.min>0.73</jacoco.branch.min>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.tgaws</groupId>
            <artifactId>tgaws-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 应用内有界队列（W4-4 管道实现） -->
        <dependency>
            <groupId>com.lmax</groupId>
            <artifactId>disruptor</artifactId>
        </dependency>
        <!-- 日志门面（管道告警/统计输出） -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <!-- W5 规则引擎：表达式求值（组合规则） -->
        <dependency>
            <groupId>com.googlecode.aviator</groupId>
            <artifactId>aviator</artifactId>
        </dependency>
        <!-- W5 统计模型：回归/统计检验 -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-math3</artifactId>
        </dependency>
        <!-- W5 规则参数解析（expression_json → 参数映射） -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- 单元测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
