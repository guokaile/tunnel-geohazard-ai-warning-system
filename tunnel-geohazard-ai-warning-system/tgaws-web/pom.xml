<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.tgaws</groupId>
        <artifactId>tgaws-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>tgaws-web</artifactId>
    <name>tgaws-web</name>
    <description>接口与装配层：Controller/启动类/全局配置/拦截器/定时任务装配（唯一可执行模块）</description>
    <properties>
        <jacoco.branch.min>0.28</jacoco.branch.min>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.tgaws</groupId>
            <artifactId>tgaws-business</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.tgaws</groupId>
            <artifactId>tgaws-access</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <!-- T-703 审计切面（@OperLog 异步脱敏；Boot 4 无 starter-aop，直引 AspectJ 运行时） -->
        <dependency>
            <groupId>org.aspectj</groupId>
            <artifactId>aspectjweaver</artifactId>
        </dependency>
        <!-- 数据库驱动 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- T-704 架构守护（Boot 4 未管理版本，显式锁定） -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>1.4.1</version>
            <scope>test</scope>
        </dependency>
        <!-- H2（MySQL 兼容模式）：测试环境，不依赖本机 MySQL 口令 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
